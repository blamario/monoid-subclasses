packages: .

tests: True

package monoid-subclasses
  -- These options mirror those generated by `haskell-ci`. If you regenerate
  -- `haskell-ci.yml`, update this list to match any additions or removals.
  ghc-options:
    -Werror=missing-methods
    -Werror=missing-fields
    -Werror=unused-packages
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
